# Copy this file to .env to change the defaults. None of these are required.

# Port the Express API listens on (the frontend dev server proxies /api here)
PORT=3001

# Origin allowed to call the API directly from a browser
CORS_ORIGIN=http://localhost:5173

# Where leaderboard scores are saved (defaults to backend/data/scores.json)
# SCORES_FILE=./data/scores.json

# How many hints a player may use per game
HINTS_PER_GAME=3

# Phase III (planned, not used yet): key for the LLM that rewords hint explanations.
# Keep it here on the server only; never put it in frontend code.
# ANTHROPIC_API_KEY=
